{
  "IMAGE_CARDS": {
    "description": "图片卡片设置",
    "type": "object",
    "items": {
      "ENABLED": {
        "description": "总开关",
        "type": "bool",
        "default": true,
        "hint": "关闭后所有界面只发文本，不再生成磨砂玻璃图片卡片。"
      },
      "CARD_HELP": {
        "description": "修仙帮助图片",
        "type": "bool",
        "default": true,
        "hint": "/修仙帮助 发送预生成的指令大全图片，图片不可用时自动降级为文本。"
      },
      "STATIC_AUTO_REGEN": {
        "description": "固定页面自动重生成",
        "type": "bool",
        "default": true,
        "hint": "帮助等固定页面文案或版本变化时自动重绘图片；关闭后仅运行生成脚本时更新。"
      },
      "CARD_INFO": {
        "description": "我的信息卡片",
        "type": "bool",
        "default": true,
        "hint": "/我的信息 追加图片卡片。"
      },
      "CARD_CHECKIN": {
        "description": "签到卡片",
        "type": "bool",
        "default": true,
        "hint": "/签到 追加图片卡片。"
      },
      "CARD_BAG": {
        "description": "储物戒卡片",
        "type": "bool",
        "default": true,
        "hint": "/储物戒 追加图片卡片。"
      },
      "CARD_PET": {
        "description": "灵兽卡片",
        "type": "bool",
        "default": true,
        "hint": "/我的灵兽 追加图片卡片。"
      },
      "CARD_BOSS": {
        "description": "世界Boss状态卡片",
        "type": "bool",
        "default": true,
        "hint": "/世界Boss状态 追加图片卡片。"
      },
      "CARD_FARM": {
        "description": "灵田卡片",
        "type": "bool",
        "default": true,
        "hint": "/我的灵田 追加图片卡片。"
      },
      "CARD_COMBAT": {
        "description": "战斗结算海报",
        "type": "bool",
        "default": true,
        "hint": "Boss击杀结算追加图片海报。"
      },
      "CARD_SHOP": {
        "description": "商店货架卡片",
        "type": "bool",
        "default": true,
        "hint": "/丹阁 /器阁 /百宝阁 追加图片卡片。"
      },
      "CARD_MARKET": {
        "description": "坊市列表卡片",
        "type": "bool",
        "default": true,
        "hint": "/坊市 追加图片卡片。"
      },
      "CARD_EQUIP": {
        "description": "我的装备卡片",
        "type": "bool",
        "default": true,
        "hint": "/我的装备 追加图片卡片。"
      }
    }
  },
  "MARKET_NPC": {
    "description": "坊市NPC问价",
    "type": "object",
    "items": {
      "ENABLED": {
        "description": "启用NPC问价",
        "type": "bool",
        "default": true,
        "hint": "玩家上架坊市后，NPC会按随机间隔发来问价。"
      },
      "MIN_INTERVAL": {
        "description": "最短问价间隔（秒）",
        "type": "int",
        "default": 3000,
        "hint": "每个商品两次NPC问价之间的最短随机间隔，默认3000秒（50分钟）。"
      },
      "MAX_INTERVAL": {
        "description": "最长问价间隔（秒）",
        "type": "int",
        "default": 4200,
        "hint": "每个商品两次NPC问价之间的最长随机间隔，默认4200秒（70分钟）。"
      },
      "MIN_RATE": {
        "description": "问价下限比例",
        "type": "float",
        "default": 0.8,
        "hint": "NPC问价相对玩家定价的最低比例，0.8表示最低八折（定价50可能问40）。"
      },
      "MAX_RATE": {
        "description": "问价上限比例",
        "type": "float",
        "default": 1.2,
        "hint": "NPC问价相对玩家定价的最高比例，1.2表示最高加价两成（定价50可能问60）。"
      },
      "MAX_LISTING_MULTIPLIER": {
        "description": "NPC问价定价上限倍数",
        "type": "float",
        "default": 2.0,
        "hint": "玩家定价超过物品标准价值的该倍数时，NPC不会前来问价。默认2倍，0表示不限制。"
      },
      "OFFER_EXPIRE": {
        "description": "问价有效期（秒）",
        "type": "int",
        "default": 1800,
        "hint": "NPC问价超过该时间未处理会自动过期，玩家需继续等待下一次问价。默认1800秒。"
      },
      "CHECK_INTERVAL": {
        "description": "问价检查周期（秒）",
        "type": "int",
        "default": 60,
        "hint": "后台扫描并生成NPC问价的周期，默认60秒。"
      }
    }
  },
  "AUCTION_HOUSE": {
    "description": "拍卖会事件",
    "type": "object",
    "items": {
      "ENABLED": {
        "description": "启用拍卖会",
        "type": "bool",
        "default": true,
        "hint": "关闭后不再排期、报名和播报拍卖会。"
      },
      "CYCLE_DAYS": {
        "description": "筹备窗口天数",
        "type": "int",
        "default": 3,
        "hint": "每 N 天内随机选一天作为预告日，当天 22:00 开拍。"
      },
      "ANNOUNCE_START_HOUR": {
        "description": "预告开始小时",
        "type": "int",
        "default": 10,
        "hint": "预告日从该小时开始每小时提醒一次。"
      },
      "ANNOUNCE_END_HOUR": {
        "description": "预告结束小时",
        "type": "int",
        "default": 21,
        "hint": "默认 21 点后不再发预告，22 点直接开拍。"
      },
      "EVENT_START_HOUR": {
        "description": "开拍小时",
        "type": "int",
        "default": 22,
        "hint": "预告日当天该小时开拍。"
      },
      "ENTRY_FEE": {
        "description": "入场费（灵石）",
        "type": "int",
        "default": 500,
        "hint": "报名时一次性扣除，正常开拍后不退。"
      },
      "LOT_DURATION": {
        "description": "单件拍品固定时长（秒）",
        "type": "int",
        "default": 600,
        "hint": "每件拍品最多占用该时长，之后进入下一件。"
      },
      "BID_COUNTDOWN": {
        "description": "出价倒计时（秒）",
        "type": "int",
        "default": 60,
        "hint": "首次出价后进入倒计时，后续出价会重置。"
      },
      "LOT_GAP": {
        "description": "拍品间隔（秒）",
        "type": "int",
        "default": 10,
        "hint": "上一件结算后到下一件开始前的缓冲时间。"
      },
      "MIN_INCREMENT_PCT": {
        "description": "最低加价比例",
        "type": "float",
        "default": 0.05,
        "hint": "后续出价至少比当前价高该比例，0.05 表示 5%。"
      },
      "LOT_COUNT": {
        "description": "每场拍品数量",
        "type": "int",
        "default": 10,
        "hint": "最多读取 config/auction_house_config.json 的前 N 件拍品。"
      },
      "AI_ENABLED": {
        "description": "启用 AI 播报",
        "type": "bool",
        "default": true,
        "hint": "关闭或 AI 不可用时自动使用模板播报。"
      },
      "AI_PROVIDER_ID": {
        "description": "固定 AI Provider ID",
        "type": "string",
        "default": "",
        "hint": "留空则使用首个白名单群当前会话的 Provider。"
      },
      "AI_TIMEOUT": {
        "description": "AI 超时（秒）",
        "type": "int",
        "default": 8,
        "hint": "超时后自动降级为模板播报。"
      },
      "AI_MAX_CHARS": {
        "description": "AI 文案最大字数",
        "type": "int",
        "default": 300,
        "hint": "限制 AI 生成内容长度，避免刷屏。"
      },
      "AI_BID_BROADCAST": {
        "description": "出价也使用 AI 播报",
        "type": "bool",
        "default": false,
        "hint": "关闭时出价播报使用模板，减少 AI 调用次数。"
      }
    }
  },
  "ACCESS_CONTROL": {
    "description": "访问控制",
    "type": "object",
    "items": {
      "WHITELIST_GROUPS": {
        "description": "白名单群号列表",
        "type": "list",
        "default": [],
        "hint": "请添加允许使用此插件的QQ群号。留空则表示所有群聊都可用。"
      },
      "SHOP_MANAGERS": {
        "description": "商店管理员名单",
        "type": "list",
        "default": [],
        "hint": "可以手动刷新商店的用户ID（字符串）。为空则不允许任何人手动刷新商店。"
      },
      "BOSS_ADMINS": {
        "description": "Boss管理员名单",
        "type": "list",
        "default": [],
        "hint": "可以手动生成Boss/开启团本/结束团本/开启与结束天魔入侵/开启魔潮的用户ID（字符串）。为空则不允许任何人手动管理Boss与全服事件。"
      }
    }
  },
  "VALUES": {
    "description": "核心数值配置",
    "type": "object",
    "items": {
      "INITIAL_GOLD": {
        "description": "初始灵石",
        "type": "int",
        "default": 100,
        "hint": "新玩家创建角色时获得的初始灵石数量。"
      },
      "BASE_EXP_PER_MINUTE": {
        "description": "闭关基础修为（每分钟）",
        "type": "int",
        "default": 100,
        "hint": "闭关修炼时，每分钟获得的基础修为值（会受灵根倍率影响）。"
      },
      "LEVEL_EXP_BONUS_PER_LEVEL": {
        "description": "境界修为加成（每级）",
        "type": "float",
        "default": 0.1,
        "hint": "每提升一个境界等级，闭关修为收益增加的比例。0.1 表示每级 +10%。"
      },
      "CHECK_IN_GOLD_MIN": {
        "description": "签到灵石奖励（最小值）",
        "type": "int",
        "default": 50,
        "hint": "每日签到获得的最少灵石数量。"
      },
      "CHECK_IN_GOLD_MAX": {
        "description": "签到灵石奖励（最大值）",
        "type": "int",
        "default": 500,
        "hint": "每日签到获得的最多灵石数量。"
      },
      "BREAKTHROUGH_DEATH_PROBABILITY": {
        "description": "突破失败死亡概率范围",
        "type": "list",
        "default": [0.01, 0.1],
        "hint": "突破失败时的死亡概率范围。第一个值为最小概率（1%），第二个值为最大概率（10%）。每次突破失败会在此范围内随机一个死亡概率。"
      },
      "BODY_BREAKTHROUGH_DEATH_MULTIPLIER": {
        "description": "体修突破失败死亡概率倍率",
        "type": "float",
        "default": 1.5,
        "hint": "体修突破失败时的死亡概率额外倍率。1.5 表示比灵修高 50%，设置为 1.0 则与灵修相同。"
      },
      "PAVILION_REFRESH_HOURS": {
        "description": "阁楼刷新时间（小时）",
        "type": "int",
        "default": 1,
        "hint": "丹阁、器阁、百宝阁自动刷新的间隔时间（小时）。设置为0则不自动刷新。"
      },
      "PAVILION_PILL_COUNT": {
        "description": "丹阁展示数量",
        "type": "int",
        "default": 20,
        "hint": "丹阁展示的丹药数量。"
      },
      "PAVILION_WEAPON_COUNT": {
        "description": "器阁展示数量",
        "type": "int",
        "default": 30,
        "hint": "器阁展示的装备数量；数量越大，高境界装备也越容易出现。"
      },
      "PAVILION_TREASURE_COUNT": {
        "description": "百宝阁展示数量",
        "type": "int",
        "default": 40,
        "hint": "百宝阁展示的物品数量；数量越大，可选范围越广。"
      },
      "SHOP_DISCOUNT_MIN": {
        "description": "折扣最小值",
        "type": "float",
        "default": 0.6,
        "hint": "物品折扣的最小值（0.8表示8折）。"
      },
      "SHOP_DISCOUNT_MAX": {
        "description": "折扣最大值",
        "type": "float",
        "default": 1.4,
        "hint": "物品折扣的最大值（1.2表示1.2倍价格）。"
      },
      "SHOP_STOCK_DIVISOR": {
        "description": "库存计算基数",
        "type": "int",
        "default": 100,
        "hint": "库存=物品权重/基数。基数越大，库存越少。"
      },
      "PAVILION_RARE_RECIPE_COUNT": {
        "description": "丹方阁稀有丹方数量",
        "type": "int",
        "default": 3,
        "hint": "丹方阁每次随机刷新的稀有丹方数量；突破所需丹方会常驻提供，不占用此数量。"
      },
      "PAVILION_MATERIAL_COUNT": {
        "description": "材料阁展示数量",
        "type": "int",
        "default": 20,
        "hint": "材料阁展示的材料数量。"
      }
    }
  },
  "BANK": {
    "description": "灵石银行配置",
    "type": "object",
    "items": {
      "DAILY_INTEREST_RATE": {
        "description": "存款日利率",
